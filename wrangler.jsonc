{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sub-hub",
  "main": "sub-hub-worker.js",
  "compatibility_date": "2026-01-10",
  "workers_dev": true,
  "vars": {
    "ADMIN_PATH": "admin",
    "TURNSTILE_SITE_KEY": "",
    "TURNSTILE_HOSTNAME": ""
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sub-hub-db",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "deploy-migrations"
    }
  ]
}
